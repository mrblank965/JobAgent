  "vectorStore": "keyword-inverted",
  "points": [
    {
      "category": "coreDuties",
      "text": "全权负责基金的管理，一只基金业绩如何几乎完全取决于基金经理个人。",
      "kpId": "fin-fund-pm-kp-001"
    },
    {
      "category": "coreDuties",
      "text": "时刻做重大决策，管理大量客户资金，承担声誉和职业前途风险。",
      "kpId": "fin-fund-pm-kp-002"
    },
    {
      "category": "coreDuties",
      "text": "每天考虑排名，由于相对排名考核机制，排名低需重新考虑投资策略。",
      "kpId": "fin-fund-pm-kp-003"
    },
    {
      "category": "coreDuties",
      "text": "拜访客户，多为机构投资者，保险和国企财务公司居多。",
      "kpId": "fin-fund-pm-kp-004"
    },
    {
      "category": "coreDuties",
      "text": "拜访渠道，银行居多，为渠道销售人员培训，也有直接面对渠道客户的交流活动。",
      "kpId": "fin-fund-pm-kp-005"
    },
    {
      "category": "coreDuties",
      "text": "与投资人互动，包括市场活动、固定专栏、文章等。",
      "kpId": "fin-fund-pm-kp-006"
    },
    {
      "category": "coreDuties",
      "text": "每年若干次实地去上市公司调研。",
      "kpId": "fin-fund-pm-kp-007"
    },
    {
      "category": "coreDuties",
      "text": "每天坚持学习新的商业模式、新的经济动态、上市公司最新进展。",
      "kpId": "fin-fund-pm-kp-008"
    },
    {
      "category": "coreDuties",
      "text": "每天晚上坚持看上市公司公告，跟踪主要上市公司最新动态。",
      "kpId": "fin-fund-pm-kp-009"
    },
    {
      "category": "coreDuties",
      "text": "管理自己的时间，判断社会、行业、公司逻辑并寻找支持或不支持的证据，然后做出决策。",
      "kpId": "fin-fund-pm-kp-010"
    },
    {
      "category": "coreDuties",
      "text": "90%工作时间在研究，阅读研究资料，与研究员讨论，与企业家或同行交流。",
      "kpId": "fin-fund-pm-kp-011"
    },
    {
      "category": "coreDuties",
      "text": "每周阅读研究员提交的研究周报（5位研究员合计约8.5万字），一年仅此一项超过400万字，平均每周与研究员沟通8小时。",
      "kpId": "fin-fund-pm-kp-012"
    },
    {
      "category": "coreDuties",
      "text": "阅读管理者讲话、专业论文和书籍等。",
      "kpId": "fin-fund-pm-kp-013"
    },
    {
      "category": "coreDuties",
      "text": "与资深业内同行交流，探讨生意模式、管理水平等宏观话题。",
      "kpId": "fin-fund-pm-kp-014"
    },
    {
      "category": "coreDuties",
      "text": "与实业企业家紧密沟通，多时一周交流4-5次。",
      "kpId": "fin-fund-pm-kp-015"
    },
    {
      "category": "coreDuties",
      "text": "用大量时间和精力思考一系列问题，大到事物本质、人性特点、研究方向，细到重要细节数据。",
      "kpId": "fin-fund-pm-kp-016"
    },
    {
      "category": "coreDuties",
      "text": "用几十个问题“拷问”一个观点，以判断其准确性与合理性。",
      "kpId": "fin-fund-pm-kp-017"
    },
    {
      "category": "coreDuties",
      "text": "将重要信息内化到大脑，不写研究报告。",
      "kpId": "fin-fund-pm-kp-018"
    },
    {
      "category": "coreDuties",
      "text": "每天工作满满当当，从早上六点到深夜十一二点都可能处理工作消息。",
      "kpId": "fin-fund-pm-kp-019"
    },
    {
      "category": "coreDuties",
      "text": "没有每日晨会、每周例会或严格时间安排表，工作节奏无规律。",
      "kpId": "fin-fund-pm-kp-020"
    },
    {
      "category": "coreDuties",
      "text": "与研究员几乎每周有团队沟通和一对一沟通，问题导向，为解决具体问题。",
      "kpId": "fin-fund-pm-kp-021"
    },
    {
      "category": "coreDuties",
      "text": "随时随地都在工作，利用琐碎时间看书。",
      "kpId": "fin-fund-pm-kp-022"
    },
    {
      "category": "coreDuties",
      "text": "春节假期也进行“花式调研”、铁打看盘、读“无用书”。",
      "kpId": "fin-fund-pm-kp-023"
    },
    {
      "category": "coreDuties",
      "text": "假期留意亲友使用的手机品牌和型号、与新能源汽车车主畅聊，了解行业趋势。",
      "kpId": "fin-fund-pm-kp-024"
    },
    {
      "category": "coreDuties",
      "text": "抽时间去家乡附近小城转转，了解吸引人才的政策和产业，观察基础设施变化和商场消费热度。",
      "kpId": "fin-fund-pm-kp-025"
    },
    {
      "category": "coreDuties",
      "text": "观察道路、人车情况、新住宅区价格及居民入住率等，辅助判断地产变化。",
      "kpId": "fin-fund-pm-kp-026"
    },
    {
      "category": "coreDuties",
      "text": "观察景区和酒店一次性用品使用情况，判断塑料行业和新材料行业趋势。",
      "kpId": "fin-fund-pm-kp-027"
    },
    {
      "category": "coreDuties",
      "text": "假期每天睁眼先打开新闻资讯APP查看行业新闻动态，打开金融数据工具类APP看外盘对标公司行情和国际市场相关资产走势，打开专业类微信公众号了解宏观和行业公司层面信息。",
      "kpId": "fin-fund-pm-kp-028"
    },
    {
      "category": "coreDuties",
      "text": "海外度假时在沙滩上看盘。",
      "kpId": "fin-fund-pm-kp-029"
    },
    {
      "category": "coreDuties",
      "text": "读政治、经济、历史、科学、人物传记等“无用书”。",
      "kpId": "fin-fund-pm-kp-030"
    },
    {
      "category": "workflow",
      "text": "7:00左右起床，刷牙洗脸收拾，顺便再看看国外市场情况。",
      "kpId": "fin-fund-pm-kp-031"
    },
    {
      "category": "workflow",
      "text": "7:30左右出门，坐地铁前往金融街，路上继续看国外市场和重要经济数据发布情况，有时也看看报纸。",
      "kpId": "fin-fund-pm-kp-032"
    },
    {
      "category": "workflow",
      "text": "8:00左右到公司，打开电脑，继续了解昨夜至今晨发生的主要经济/金融事件，为晨会做准备。",
      "kpId": "fin-fund-pm-kp-033"
    },
    {
      "category": "workflow",
      "text": "8:30左右晨会，总结昨天和昨夜金融市场情况，展望今天的情况，重点行业/股票可能有什么动态；有些公司还会让研究员/基金经理具体说一说推荐行业/股票。",
      "kpId": "fin-fund-pm-kp-034"
    },
    {
      "category": "workflow",
      "text": "9:15左右晨会结束，当天要下单的基金经理一般会和交易员预先交流一下。",
      "kpId": "fin-fund-pm-kp-035"
    },
    {
      "category": "workflow",
      "text": "9:30-11:30开盘时间，看盘，确认交易计划的执行情况，上午不做太多研究，多以看盘和处理零碎信息为主，挑选感兴趣的卖方报告或公司研究员报告准备之后看。",
      "kpId": "fin-fund-pm-kp-036"
    },
    {
      "category": "workflow",
      "text": "11:30-12:30约感兴趣的研究员/基金经理吃个饭，席间继续讨论投资。",
      "kpId": "fin-fund-pm-kp-037"
    },
    {
      "category": "workflow",
      "text": "13:00-15:00看盘，见一些卖方来拜访的人，下午一般不下单交易，除非市场当天有重大变化或情况发生。",
      "kpId": "fin-fund-pm-kp-038"
    },
    {
      "category": "workflow",
      "text": "15:00-17:30做明天的交易计划，调整组合，读研报，读新闻，读杂志，穿插跟同行的电话。",
      "kpId": "fin-fund-pm-kp-039"
    },
    {
      "category": "workflow",
      "text": "17:30大部分公司可以下班，但基金经理一般不会这么早走，饭局除外，多数人继续读上午挑出来的研报，做一些自己感兴趣方向的研究，看大量文章。",
      "kpId": "fin-fund-pm-kp-040"
    },
    {
      "category": "workflow",
      "text": "21:00看有没有重要的交易所公告出来，看看美股开盘情况，逗逗孩子，陪陪媳妇；年轻的新基金经理可能继续读研报，做研究。",
      "kpId": "fin-fund-pm-kp-041"
    },
    {
      "category": "workflow",
      "text": "上午到公司后阅读研究资料，有疑惑或发现有意思的现象时与研究员讨论；当天需与企业家或同行交流则外出赴约，结束后继续阅读研究资料或思考研究方向。",
      "kpId": "fin-fund-pm-kp-042"
    },
    {
      "category": "workflow",
      "text": "每周五研究员提交研究周报，基金经理消化吸收后针对具体问题与研究员探讨。",
      "kpId": "fin-fund-pm-kp-043"
    },
    {
      "category": "workflow",
      "text": "与研究员沟通不是例会制，而是问题导向，每次沟通为解决具体问题。",
      "kpId": "fin-fund-pm-kp-044"
    },
    {
      "category": "workflow",
      "text": "每天下午四五点是一天中最累的时候，可能稍作休息；每天晚上大脑比较清醒，凌晨看看报告很正常。",
      "kpId": "fin-fund-pm-kp-045"
    },
    {
      "category": "workflow",
      "text": "状态好多阅读，状态差停下来放松，比如走走路、听听歌、刷刷短视频。",
      "kpId": "fin-fund-pm-kp-046"
    },
    {
      "category": "workflow",
      "text": "基金经理买股票通常考虑六大因素：上市公司基本面的价值判断、市场策略和风格、股价催化剂、市场大势判断、技术分析、组合均衡需要；综合权衡后评估上涨和下跌的潜在空间及概率，做出决策。",
      "kpId": "fin-fund-pm-kp-047"
    },
    {
      "category": "workflow",
      "text": "如果认为一只股票上涨有50%的空间、下跌有10%的空间，就会考虑买；如果上涨概率有80%、下跌概率有20%，就会立即行动。",
      "kpId": "fin-fund-pm-kp-048"
    },
    {
      "category": "workflow",
      "text": "通过努力研究大量买卖，尽量做到正确次数多于错误次数；对公司跟踪紧密，基本面出问题及时止损纠错；基本面没有不利变化且估值合理时尽量更长时间持有股票。",
      "kpId": "fin-fund-pm-kp-049"
    },
    {
      "category": "workflow",
      "text": "春节假期一天通常：早上一睁眼逐一打开各个新闻资讯APP查看相关行业新闻动态；打开金融数据工具类APP看外盘对标公司行情和国际市场相关资产走势；打开常看的几个专业类微信公众号了解宏观和行业公司层面信息。",
      "kpId": "fin-fund-pm-kp-050"
    },
    {
      "category": "workflow",
      "text": "春节7天看完3本书，如《大秦帝国》《岛上书店》《巴菲特致股东的信》，做到“少喝酒，喝好酒”，尽量少参加无用聚会。",
      "kpId": "fin-fund-pm-kp-051"
    },
