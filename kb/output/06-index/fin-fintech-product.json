  "points": [
    {
      "category": "coreDuties",
      "text": "对市场进行判断，基于判断推进金融产品引入，承担买手角色，选择恰当的引入时机，作为防范产品风险的第一道防线。",
      "kpId": "fin-fintech-product-kp-001"
    },
    {
      "category": "coreDuties",
      "text": "评估并选择优秀的产品管理人，作为防范产品风险的第二道防线。",
      "kpId": "fin-fintech-product-kp-002"
    },
    {
      "category": "coreDuties",
      "text": "深入了解各类产品的投资运作机制，厘清产品资金流向、收益获取方式、收益影响因素及承担的风险。",
      "kpId": "fin-fintech-product-kp-003"
    },
    {
      "category": "coreDuties",
      "text": "慎重对待产品风险，识别所有风险，以发展眼光评估风险，具备底线思维，并制定多重风险应对措施。",
      "kpId": "fin-fintech-product-kp-004"
    },
    {
      "category": "coreDuties",
      "text": "制定并不断优化产品准入标准或白名单制度，明确产品引入方向，搜集全面信息，进行定量与定性分析，形成准入框架和标准并定期检验。",
      "kpId": "fin-fintech-product-kp-005"
    },
    {
      "category": "coreDuties",
      "text": "设计产品推进路径，结合市场、产品和公司情况制定个性化推广方案。",
      "kpId": "fin-fintech-product-kp-006"
    },
    {
      "category": "coreDuties",
      "text": "持续学习，跟踪财富管理市场与产品变化，提升专业能力。",
      "kpId": "fin-fintech-product-kp-007"
    },
    {
      "category": "coreDuties",
      "text": "需求调研与产品规划：调研金融机构、C端用户、B端商户等多方需求，分析竞品、市场趋势及监管政策，制定产品战略、定位与迭代路线图，输出可行性分析报告。",
      "kpId": "fin-fintech-product-kp-008"
    },
    {
      "category": "coreDuties",
      "text": "产品设计与需求落地：梳理金融业务逻辑，绘制原型与业务流程图，撰写PRD，明确功能模块、交互逻辑、数据规则与风控节点，对接研发、设计、测试团队。",
      "kpId": "fin-fintech-product-kp-009"
    },
    {
      "category": "coreDuties",
      "text": "项目推进与跨部门协同：统筹研发进度，协调业务、技术、风控、法务、运营、合规等多部门资源，把控开发、测试、上线全流程。",
      "kpId": "fin-fintech-product-kp-010"
    },
    {
      "category": "coreDuties",
      "text": "合规风控与风险把控：将监管要求与风险管控逻辑嵌入产品，参与风控规则与合规流程设计，规避合规风险、数据安全风险与金融业务风险。",
      "kpId": "fin-fintech-product-kp-011"
    },
    {
      "category": "coreDuties",
      "text": "产品迭代与运营赋能：跟踪上线后的用户数据、业务数据与运营反馈，分析优化方向，迭代功能与流程，配合运营团队制定推广方案。",
      "kpId": "fin-fintech-product-kp-012"
    },
    {
      "category": "coreDuties",
      "text": "设计供应链金融产品方案，基于历史供应链数据评估方案优劣，运用金融专业知识进行净损益等指标分析，用数据证明方案好坏。",
      "kpId": "fin-fintech-product-kp-013"
    },
    {
      "category": "coreDuties",
      "text": "研究老产品的背景、细节、运作与营销，总结情景推演，获取未来产品设计的经验与灵感。",
      "kpId": "fin-fintech-product-kp-014"
    },
    {
      "category": "coreDuties",
      "text": "产品经理的首要使命是写文件，包括基金合同、招募说明书、产品方案、业绩模拟等，并需能构建业绩组合模型、绘制模拟收益曲线。",
      "kpId": "fin-fintech-product-kp-015"
    },
    {
      "category": "coreDuties",
      "text": "配合销售向投资者解释产品，在业绩不佳时可能需承担销售辅助或客户沟通工作。",
      "kpId": "fin-fintech-product-kp-016"
    },
    {
      "category": "coreDuties",
      "text": "在业务创新要求下准备新方案，参与产品创新设计。",
      "kpId": "fin-fintech-product-kp-017"
    },
