{
  "status": "indexed",
  "positionId": "fin-ib-research",
  "positionName": "券商研究员",
  "aliases": [
    "行业研究员",
    "卖方分析师",
    "研究所分析师",
    "证券分析师"
  ],
  "vectorStore": "keyword-inverted",
  "points": [
    {
      "category": "coreDuties",
      "text": "看报告、写报告是研究所的主要任务，研究所是宏观、策略、行业、公司、市场等方面的主要提供者。",
      "kpId": "fin-ib-research-kp-001"
    },
    {
      "category": "coreDuties",
      "text": "为机构销售部服务，为大客户提供研究分析报告，客户认可研究水平后会更倚重该公司的销售部门进行交易，证券公司从而获得更多佣金。",
      "kpId": "fin-ib-research-kp-002"
    },
    {
      "category": "coreDuties",
      "text": "撰写行业研究报告、周报、公司深度报告和事件点评报告；事件点评报告一般针对公司季报、半年报、年报和重点公告，由事件、点评观点和盈利预测组成，篇幅较短；公司深度报告一般在20-30页之间，涉及公司所属行业分析、公司分析和盈利预测等内容。",
      "kpId": "fin-ib-research-kp-003"
    },
    {
      "category": "coreDuties",
      "text": "通过对于行业的理解以及调研，形成研究报告，向投资者路演推票，收取分仓佣金，并不涉及直接的投资行为。",
      "kpId": "fin-ib-research-kp-004"
    },
    {
      "category": "coreDuties",
      "text": "定位于行业专家，用宏观的视野、全局的思路、战略的眼光把握所研究行业或公司的运行规律，深刻理解行业或企业的业务发展、产品与服务、运营管理、营销管理等管理事宜，并能够像上市公司高管人员一样思考企业发展的问题。",
      "kpId": "fin-ib-research-kp-005"
    },
    {
      "category": "coreDuties",
      "text": "研究员不仅要认真做好研究，还要走向市场兼顾销售；只有研究没销售和只销售没研究的研究员将来都无法在卖方立足和生存。",
      "kpId": "fin-ib-research-kp-006"
    },
    {
      "category": "coreDuties",
      "text": "部分券商对研究员的考核侧重研报推荐的个股后续走势，将模拟荐股正式纳入绩效考核。",
      "kpId": "fin-ib-research-kp-007"
    },
    {
      "category": "coreDuties",
      "text": "服务投行业务，为IPO发行人撰写报告；服务机构交易人，机构销售员拿着观点去分食分仓佣金；服务散户客户，通过营业部经理们向炒股一族传播每周金股或热点报告。",
      "kpId": "fin-ib-research-kp-008"
    },
    {
      "category": "coreDuties",
      "text": "通过调研和上市公司董秘、证券代表打交道。",
      "kpId": "fin-ib-research-kp-009"
    },
    {
      "category": "workflow",
      "text": "研究报告的主要资料来源为相关部委新闻报告、行业协会、咨询报告、行业重要网站、企业招股说明书、企业公告和企业年报。",
      "kpId": "fin-ib-research-kp-010"
    },
    {
      "category": "workflow",
      "text": "事件点评报告由事件、点评观点和盈利预测组成；公司深度报告涉及公司所属行业分析（如宏观经济、行业概况、行业特征、行业政策、产业链分析、产业供需分析等）、公司分析（如股权结构、财务分析、同业比较等）和盈利预测。",
      "kpId": "fin-ib-research-kp-011"
    },
    {
      "category": "workflow",
      "text": "卖方研究通过自己对于行业的理解以及调研，形成研究报告，向投资者路演推票收取分仓佣金。",
      "kpId": "fin-ib-research-kp-012"
    },
    {
      "category": "workflow",
      "text": "此前券商对研究员的考核指标主要是研究员在相关评选中的名次，名次直接挂钩公募基金分仓额度的多寡；评选暂停后，考核指标面临调整，有的券商拟采取研究销售并重，有的注重荐股能力。",
      "kpId": "fin-ib-research-kp-013"
    },
    {
      "category": "workflow",
      "text": "部分中小券商在抢占卖方研究市场时，直接高价从别的卖方机构挖角已在评选中榜上有名的分析师，因为这些分析师自带公募基金分仓收入。",
      "kpId": "fin-ib-research-kp-014"
    },
    {
      "category": "tools",
      "text": "国内学术数据库：知网、万方、人大复印资料、维普、中经网、国研网、上海公共研发平台。",
      "kpId": "fin-ib-research-kp-015"
    },
    {
      "category": "tools",
      "text": "国外学术数据库：EBSCO、Elsevier。",
      "kpId": "fin-ib-research-kp-016"
    },
    {
      "category": "tools",
      "text": "免费数据库：数据汇、数据圈、FRED、OECD、台湾学术数据库、台湾大学电子书。",
      "kpId": "fin-ib-research-kp-017"
    },
    {
      "category": "tools",
      "text": "共享文库：百度文库、豆丁文库、爱问共享、道客巴巴、智库文档、文库大全、IT168文库、CSDN文库、呱仕网、新浪地产。",
      "kpId": "fin-ib-research-kp-018"
    },
    {
      "category": "tools",
      "text": "专业论坛：人大经济论坛、经济学家、雪球网、理想在线、投行先锋论坛、春晖投行在线、股票报告网、渐飞数据伴侣、智堡。",
      "kpId": "fin-ib-research-kp-019"
    },
    {
      "category": "tools",
      "text": "政府部门网站：国家统计局、工业和信息化部、中国人民银行、银监会、中国海关、国家知识产权局、中国证监会、巨潮信息网、行业协会、国家企业信用信息公示系统、全国法院被执行人信息查询、中国裁判文书网。",
      "kpId": "fin-ib-research-kp-020"
    },
    {
      "category": "tools",
      "text": "证券交易所：上海证券交易所、深圳证券交易所、全国中小企业股份转让系统（新三板）、香港证券交易所、台湾证券交易所、新加坡证券交易所、纽约证券交易所、纳斯达克证券交易所。",
      "kpId": "fin-ib-research-kp-021"
    },
    {
      "category": "tools",
      "text": "企业信息查询：中国人民银行征信中心、巨潮资讯网、中国银行间市场交易商协会、中国货币网、中国债券信息网、上海股权交易中心、浙江股权交易中心、齐鲁股权交易中心、前海股权交易中心。",
      "kpId": "fin-ib-research-kp-022"
    },
    {
      "category": "tools",
      "text": "报告下载渠道：迈博汇金、东方财富下属的choice资讯；公告在巨潮网查看。",
      "kpId": "fin-ib-research-kp-023"
    },
    {
      "category": "tools",
      "text": "金融工程分析师要求熟练掌握MATLAB、EXCEL等软件，能熟练使用统计分析软件如SPSS或EViews等。",
      "kpId": "fin-ib-research-kp-024"
    },
    {
      "category": "typicalDay",
      "text": "卖方研究员每天睡4-5个小时非常正常，且没有正常的假日，需要随时关注市场动向和公司公告，联系调研和路演的过程也是一把辛酸泪。研究所是后台消耗部门，并不直接产生利润，因此人员流动大，券商作为高度市场化的行业，竞争压力不言而喻。",
      "kpId": "fin-ib-research-kp-025"
    },
    {
      "category": "pitfalls",
      "text": "金融行业工作强度大，长期脑力劳动强度大、生活不规律、缺少运动，心脑血管病成为生命的最大威胁；有36岁券商研究员过劳猝死，最后遗言是“很累”。",
      "kpId": "fin-ib-research-kp-026"
    },
    {
      "category": "pitfalls",
      "text": "市场化券商收入波动很大，有的人这个月收入极高，下个月可能就会很低。",
      "kpId": "fin-ib-research-kp-027"
    },
    {
      "category": "pitfalls",
      "text": "评选暂停后研究所内部考核指标面临调整，研究员一时无所适从、内心忐忑。",
      "kpId": "fin-ib-research-kp-028"
    },
    {
      "category": "pitfalls",
      "text": "部分券商研究报告成为坑害散户交易者的工具，有个别行业分析师利用特殊权力为自己的秘密组合服务：用各种途径偷偷买入股票，带领私募客户去上市公司调研，最后发出“强烈买入”的报告，通过营业部客户经理转发观点影响散户买入，再寻找时机脱手自己的预埋仓位。",
      "kpId": "fin-ib-research-kp-029"
    },
    {
      "category": "pitfalls",
      "text": "监管通报指出证券分析师发布研究报告在合规方面存在四大问题：研究方法审慎性、分析依据合理性不足；报告标题具有夸大、诱导性；“禁止传播误导性信息”要求落实不到位；研报质量审核和合规审查不充分。",
      "kpId": "fin-ib-research-kp-030"
    },
    {
      "category": "pitfalls",
      "text": "有券商为抢热点邀请滴滴副总裁发表看法，事后证明该副总裁是假货。",
      "kpId": "fin-ib-research-kp-031"
    },
    {
      "category": "pitfalls",
      "text": "卖方研究为了迎合买方，无论研究还是销售都太功利；研究本应是一门需要沉下心、踏踏实实的智力活。",
      "kpId": "fin-ib-research-kp-032"
    },
    {
      "category": "pitfalls",
      "text": "券商研究所过度依靠公募、私募佣金的商业模式被指畸形，依靠佣金带来高收入的提成机制导致研究员在提供卖方研究时偏离上市公司基本面现象时有发生。",
      "kpId": "fin-ib-research-kp-033"
    },
    {
      "category": "pitfalls",
      "text": "那些策略研究很牛的研究员，一旦名气起来后，多直接转行自己做投资去了，真正有水平且依然留在研究机构沉下心来做卖方研究的越来越稀有。",
      "kpId": "fin-ib-research-kp-034"
    },
    {
      "category": "pitfalls",
      "text": "采取模拟荐股考核并非对所有研究员都有效，宏观研究员、宏观策略研究员就不适应；行业研究报告最后推荐的个股有诸多前提条件，最终涨跌也并非真正全面反映研究员的真实水平。",
      "kpId": "fin-ib-research-kp-035"
    },
    {
      "category": "pitfalls",
      "text": "行业研究员抱怨此前全心做好研究、上榜就有分仓和名气，榜没了以后全心做研究不可能，为了分仓可能还要去“勾搭”买方机构。",
      "kpId": "fin-ib-research-kp-036"
    },
    {
      "category": "pitfalls",
      "text": "研究所作为后台消耗部门并不直接产生利润，存在人员流动大的特点。",
      "kpId": "fin-ib-research-kp-037"
    },
    {
      "category": "pitfalls",
      "text": "大部分券商没有留京户口指标，仅有中金、中信建投、银河证券、几家资管类券商和一些央企系下的小券商拥有有限的户口指标。",
      "kpId": "fin-ib-research-kp-038"
    },
    {
      "category": "pitfalls",
      "text": "作为行业研究员，既有工作两年通过自身努力年薪几百万的新财富新贵，也有兢兢业业十几年仍默默无闻写报告的资深研究员。",
      "kpId": "fin-ib-research-kp-039"
    }
  ],
