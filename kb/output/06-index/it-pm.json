{
  "status": "indexed",
  "positionId": "it-pm",
  "positionName": "产品经理",
  "aliases": [
    "产品策划",
    "产品专员",
    "B端产品经理",
    "C端产品经理"
  ],
  "vectorStore": "keyword-inverted",
  "points": [
    {
      "category": "coreDuties",
      "text": "进行需求分析，通过海量数据分析和用户调研了解用户真实使用需求，例如分析弹幕规则、奖励机制等细节。",
      "kpId": "it-pm-kp-001"
    },
    {
      "category": "coreDuties",
      "text": "负责需求设计，输出产品方案和需求文档（PRD），将想法转化为开发可理解的原型图和详细文档。",
      "kpId": "it-pm-kp-002"
    },
    {
      "category": "coreDuties",
      "text": "与多个部门（技术、开发、设计等）沟通协调，推动产品方案落地，确保功能实现。",
      "kpId": "it-pm-kp-003"
    },
    {
      "category": "coreDuties",
      "text": "跟进产品从设计、沟通到开发的全过程，处理功能逻辑、潜在bug、用户感受等细节。",
      "kpId": "it-pm-kp-004"
    },
    {
      "category": "coreDuties",
      "text": "产品上线后关注数据表现和用户反馈，若产品不被用户接受或数据目标未达成，需进行复盘和迭代。",
      "kpId": "it-pm-kp-005"
    },
    {
      "category": "coreDuties",
      "text": "在项目推进中管理需求优先级，与业务方沟通功能背后的逻辑和预期效果。",
      "kpId": "it-pm-kp-006"
    },
    {
      "category": "coreDuties",
      "text": "参与项目管理，包括版本迭代、管理bug、管理需求等。",
      "kpId": "it-pm-kp-007"
    },
    {
      "category": "coreDuties",
      "text": "进行竞品分析、市场分析、商业模式分析（BRD）、内部外部资源分析等。",
      "kpId": "it-pm-kp-008"
    },
    {
      "category": "coreDuties",
      "text": "编写各类文档，如PRD、MRD、BRD、业务逻辑图、竞品分析报告、数据分析报告、工作汇报。",
      "kpId": "it-pm-kp-009"
    },
    {
      "category": "coreDuties",
      "text": "在AI时代，可先用AI工具构建可运行原型，再从原型代码和对话记录反推出准确PRD。",
      "kpId": "it-pm-kp-010"
    },
    {
      "category": "coreDuties",
      "text": "部分岗位需兼售前、实施、培训和客户支持，或负责产品全生命周期管理。",
      "kpId": "it-pm-kp-011"
    },
    {
      "category": "workflow",
      "text": "需求拆解：先搞清楚“为什么做”，明确需求解决的是谁的什么问题，做了能带来什么价值，把需求拆到最底层找到用户真正痛点。",
      "kpId": "it-pm-kp-012"
    },
    {
      "category": "workflow",
      "text": "方案设计：从目标倒推路径，设计产品方案并输出原型和需求文档。",
      "kpId": "it-pm-kp-013"
    },
    {
      "category": "workflow",
      "text": "推进落地：建立节奏，与设计、开发等团队成员沟通协调，推动方案实现，而不是只会催进度。",
      "kpId": "it-pm-kp-014"
    },
    {
      "category": "workflow",
      "text": "复盘迭代：把经验变成方法，对上线后的产品进行复盘和迭代。",
      "kpId": "it-pm-kp-015"
    },
    {
      "category": "workflow",
      "text": "AI时代工作流：先用Codex、Claude Code、Trae等AI工具构建可运行原型，再围绕原型评审，最后把原型沉淀成PRD。",
      "kpId": "it-pm-kp-016"
    },
    {
      "category": "workflow",
      "text": "每日制定工作计划，确定每项工作大致需要的时间、完成时间节点和紧急重要程度，按顺序执行（可参照四象限法则）。",
      "kpId": "it-pm-kp-017"
    },
    {
      "category": "workflow",
      "text": "使用番茄工作法（集中25分钟休息5分钟）或橘子集中法提高专注力和效率。",
      "kpId": "it-pm-kp-018"
    },
    {
      "category": "workflow",
      "text": "定期总结自身工作方法，将外部学到的知识通过实践转化为自己的流程。",
      "kpId": "it-pm-kp-019"
    },
    {
      "category": "tools",
      "text": "产品管理工具：JIRA、Asana、Trello",
      "kpId": "it-pm-kp-020"
    },
    {
      "category": "tools",
      "text": "市场调研工具：SurveyMonkey、Google Analytics、SEMrush",
      "kpId": "it-pm-kp-021"
    },
    {
      "category": "tools",
      "text": "原型设计工具：Sketch、Axure、Figma",
      "kpId": "it-pm-kp-022"
    },
    {
      "category": "tools",
      "text": "用户反馈工具：UserTesting、Hotjar、UsabilityHub",
      "kpId": "it-pm-kp-023"
    },
    {
      "category": "tools",
      "text": "AI原型工具：GemDesign（中文友好，文生界面，支持代码导出）、Uizard（移动端首选，支持手绘转数字）、Galileo AI（高保真UI生成，与Figma集成）",
      "kpId": "it-pm-kp-024"
    },
    {
      "category": "tools",
      "text": "AI编程工具：Codex、Claude Code、Trae",
      "kpId": "it-pm-kp-025"
    },
    {
      "category": "tools",
      "text": "AI写作工具：Claude、通义千问（用于搭建需求文档框架）",
      "kpId": "it-pm-kp-026"
    },
    {
      "category": "tools",
      "text": "AI辅助工具：Figma + AI插件（生成可编辑线框图）、AI搜索医学文献、AI生成SQL查询语句",
      "kpId": "it-pm-kp-027"
    },
    {
      "category": "tools",
      "text": "其他工具：ProcessOn（用于产品培训用户、归总客户问题）、稿定设计（海报设计）、小鹅通（课程发布）、知识星球（社群工具）、公众号（内容发布）",
      "kpId": "it-pm-kp-028"
    },
    {
      "category": "typicalDay",
      "text": "产品经理的日常工作以需求分析和沟通协调为核心。每天需要处理大量数据，从中提取有用信息并分析用户真实需求，同时与形形色色的用户打交道。在确定需求后，需设计产品方案、绘制原型图并撰写详细的需求文档，将功能背景、预期效果、逻辑细节和潜在问题都考虑清楚。随后要与设计、开发等同事反复沟通，可能因一个按钮图标或功能实现难度争论数周，最终达成一致方案。产品上线后还需关注数据表现和用户反馈，若效果不佳则需复盘迭代。此外，产品经理需参加各种会议、评审，处理琐碎事务，真正能深入写PRD、做竞品分析、数据分析的时间往往被压缩，部分工作需在加班中完成以保证质量。在硅谷，产品经理更多时间花在思考团队架构、产品策略上，并注重与团队成员口头沟通，认为这比写需求文档更高效。",
      "kpId": "it-pm-kp-029"
    },
    {
      "category": "pitfalls",
      "text": "产品经理在90%以上的公司是基础岗位，并非管理者，不要被“经理”头衔迷惑。",
      "kpId": "it-pm-kp-030"
    },
    {
      "category": "pitfalls",
      "text": "产品经理不是CEO，工作内容并非像CEO一样，需脚踏实地处理大量细节和沟通协调。",
      "kpId": "it-pm-kp-031"
    },
    {
      "category": "pitfalls",
      "text": "需求分析不难，难的是把想法和方案与工程师落地，否则想法只是想法。",
      "kpId": "it-pm-kp-032"
    },
    {
      "category": "pitfalls",
      "text": "与设计、开发沟通时可能因细节争执数周，需有耐心和沟通技巧。",
      "kpId": "it-pm-kp-033"
    },
    {
      "category": "pitfalls",
      "text": "产品上线后可能用户不买单，数据目标未达成，需提前有心理准备并持续迭代。",
      "kpId": "it-pm-kp-034"
    },
    {
      "category": "pitfalls",
      "text": "加班越多不代表能力提升越快，长期高强度加班可能导致压力大、效率低、容易烦躁、提高缓慢。",
      "kpId": "it-pm-kp-035"
    },
    {
      "category": "pitfalls",
      "text": "产品新人容易陷入琐碎事务（问问题、沟通、写日常文档、开会），导致整块工作时间稀缺，需合理规划时间。",
      "kpId": "it-pm-kp-036"
    },
    {
      "category": "pitfalls",
      "text": "没有形成自己的产品思维和方法论，做再久也难以提升。",
      "kpId": "it-pm-kp-037"
    },
    {
      "category": "pitfalls",
      "text": "不要照搬网上方法论，需通过实践将他人经验转化为自己的方法。",
      "kpId": "it-pm-kp-038"
    },
    {
      "category": "pitfalls",
      "text": "业务方可能在没有产品的情况下也能开展业务，产品经理不应被动接受所有需求，可建议用现有工具整合跑通闭环。",
      "kpId": "it-pm-kp-039"
    },
    {
      "category": "pitfalls",
      "text": "业务需求变化快，产品设计和研发周期可能跟不上，导致产品做一半需求就变了。",
      "kpId": "it-pm-kp-040"
    },
    {
      "category": "pitfalls",
      "text": "产品经理需有责任心，主动了解和帮忙解决问题，否则可能遇到开发抵触，不利于产品长期发展和团队和谐。",
      "kpId": "it-pm-kp-041"
    },
    {
      "category": "pitfalls",
      "text": "陪伴程序员加班时，可通过买零食、解答问题、帮测试等方式增进关系，但不应只做传话筒。",
      "kpId": "it-pm-kp-042"
    },
    {
      "category": "pitfalls",
      "text": "面试时需能讲清楚业务逻辑、自己具体做了什么、有无独立思考、能否接住追问、遇到分歧如何处理、结果有无依据、复盘是否具体、有无持续学习动力。",
      "kpId": "it-pm-kp-043"
    },
    {
      "category": "pitfalls",
      "text": "简历上写“负责”“主导”“从零到一”需能具体说明责任范围，避免在面试中卡壳。",
      "kpId": "it-pm-kp-044"
    },
    {
      "category": "pitfalls",
      "text": "项目成果写数字需能解释来源，没有数据就说明能确认的结果，不要随手加百分比。",
      "kpId": "it-pm-kp-045"
    },
    {
      "category": "pitfalls",
      "text": "复盘不要只说“加强沟通”“提升用户体验”，要具体到提前找谁确认、哪项规则想简单了、哪个决定导致返工等。",
      "kpId": "it-pm-kp-046"
    },
    {
      "category": "pitfalls",
      "text": "AI生成的原型需产品经理调整，不能完全依赖；涉及诊断建议等专业内容必须由专家把关。",
      "kpId": "it-pm-kp-047"
    },
    {
      "category": "pitfalls",
      "text": "AI是解放而非替代，产品经理的核心价值是定义解决用户问题的好产品，不是画原型。",
      "kpId": "it-pm-kp-048"
    },
    {
      "category": "pitfalls",
      "text": "不同公司产品经理岗位实际工作差异大，面试时需问清岗位最急需解决什么、需求由谁提出、冲突由谁拍板、分工如何、驻场出差加班安排等。",
      "kpId": "it-pm-kp-049"
    }
  ],
