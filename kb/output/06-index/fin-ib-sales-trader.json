{
  "status": "indexed",
  "positionId": "fin-ib-sales-trader",
  "positionName": "券商机构销售",
  "aliases": [
    "机构销售",
    "研究所销售",
    "券商销售交易",
    "机构业务销售"
  ],
  "vectorStore": "keyword-inverted",
  "points": [
    {
      "category": "coreDuties",
      "text": "将研究所的研究成果推送给公募基金、保险资管、私募等机构客户，帮助客户选股，从而获得机构客户的佣金。",
      "kpId": "fin-ib-sales-trader-kp-001"
    },
    {
      "category": "coreDuties",
      "text": "组织电话会议、陪同研究员路演、策划大型策略会等，本质是研究服务的销售与客户关系维护。",
      "kpId": "fin-ib-sales-trader-kp-002"
    },
    {
      "category": "coreDuties",
      "text": "帮助卖方研究员挖掘买方研究员的需求，即了解买方最近在研究什么公司、需要什么数据和想去什么公司调研，把需求告诉卖方研究员，以最快速度响应买方需求。",
      "kpId": "fin-ib-sales-trader-kp-003"
    },
    {
      "category": "coreDuties",
      "text": "在向客户推荐之前，帮客户筛选研究员及其研究成果，前提是对客户和自家研究有足够了解，慢慢树立口碑。",
      "kpId": "fin-ib-sales-trader-kp-004"
    },
    {
      "category": "coreDuties",
      "text": "日常也会为客户推一些股票。",
      "kpId": "fin-ib-sales-trader-kp-005"
    },
    {
      "category": "coreDuties",
      "text": "了解公募基金的持仓，以了解其投资偏好，对应偏好推送相应的卖方研究。",
      "kpId": "fin-ib-sales-trader-kp-006"
    },
    {
      "category": "coreDuties",
      "text": "尽可能多地认识公募基金后台和交易部门人员，以及时掌握人员变动情况，并方便日后查询对应的交易量，确保服务能转化为有效收入。",
      "kpId": "fin-ib-sales-trader-kp-007"
    },
    {
      "category": "coreDuties",
      "text": "非公募机构销售主要服务于私募、上市公司、同业金融等企业，业务内容包括融资、资产配置、金融投资、企业规划等。",
      "kpId": "fin-ib-sales-trader-kp-008"
    },
    {
      "category": "coreDuties",
      "text": "股销部通过销售研究报告，吸引机构客户在自家营业部交易，赚取佣金，可理解为高端经纪业务；同时向综合服务转型，拓展大宗交易、减持服务、QFII等业务，并与其他牌照部门协同分润。",
      "kpId": "fin-ib-sales-trader-kp-009"
    },
    {
      "category": "workflow",
      "text": "早上8点半参加晨会，听研究员讲最新的观点和市场判断，记下重点，明确当天要拜访的客户关心什么、需要准备什么材料。",
      "kpId": "fin-ib-sales-trader-kp-010"
    },
    {
      "category": "workflow",
      "text": "上午9点到下午5点，穿梭于各基金、保险的会议室，帮客户约研究员路演、传递最新的调研信息，甚至帮基金经理解决订机票酒店等琐事。",
      "kpId": "fin-ib-sales-trader-kp-011"
    },
    {
      "category": "workflow",
      "text": "晚上6点后，与基金经理吃饭喝酒，在饭桌上聊出真实需求，了解客户最近看中哪个板块、对哪类报告感兴趣。",
      "kpId": "fin-ib-sales-trader-kp-012"
    },
    {
      "category": "workflow",
      "text": "客户询价后，销售需要协调研究员响应；在研究所内部，研究员生产研报后交由质控审核、合规把关，销售再推给基金经理完成变现。",
      "kpId": "fin-ib-sales-trader-kp-013"
    },
    {
      "category": "workflow",
      "text": "实习期间日常为复印、打印、协助查资料；可参加公司晨会并做好晨会记录，平时有较多机会与自家分析师接触交流。",
      "kpId": "fin-ib-sales-trader-kp-014"
    },
    {
      "category": "tools",
      "text": "从业资格相关证书，应尽早考取。",
      "kpId": "fin-ib-sales-trader-kp-015"
    },
    {
      "category": "tools",
      "text": "万得、同花顺、东方财富等网站，用于查找行业研报、查看上市公司报告。",
      "kpId": "fin-ib-sales-trader-kp-016"
    },
    {
      "category": "tools",
      "text": "《巴菲特致股东的信》等书籍，用于培养对经济市场的感觉。",
      "kpId": "fin-ib-sales-trader-kp-017"
    },
    {
      "category": "tools",
      "text": "需要读得懂研究报告，并能把复杂服务讲清楚。",
      "kpId": "fin-ib-sales-trader-kp-018"
    },
    {
      "category": "typicalDay",
      "text": "机构销售的典型一天从早上8点半的晨会开始，听研究员讲最新的观点和市场判断并记下重点，明确当天要拜访的客户关心什么、需要准备什么材料。上午9点到下午5点，穿梭于各基金、保险的会议室，不是推销，而是服务：帮客户约研究员路演、传递最新的调研信息，甚至帮基金经理解决订机票酒店、接送娃这类琐事。晚上6点后饭局开始，和基金经理吃饭喝酒是常态，不是为了喝而喝，而是在饭桌上聊出真实需求，比如最近看中哪个板块、对哪类报告感兴趣。此外，销售需要24小时待命，客户随时可能找上门，逢年过节维护关系是基本功。",
      "kpId": "fin-ib-sales-trader-kp-019"
    },
    {
      "category": "pitfalls",
      "text": "KPI压力大，佣金收入直接跟业绩挂钩，行情不好的时候特别难受。",
      "kpId": "fin-ib-sales-trader-kp-020"
    },
    {
      "category": "pitfalls",
      "text": "需要积累，前两三年基本在建立人脉，真正赚钱是两三年以后。",
      "kpId": "fin-ib-sales-trader-kp-021"
    },
    {
      "category": "pitfalls",
      "text": "24小时待命，客户随时找你，逢年过节维护关系是基本功。",
      "kpId": "fin-ib-sales-trader-kp-022"
    },
    {
      "category": "pitfalls",
      "text": "职业天花板明显，销售做到头就是销售总监，很难再往上升。",
      "kpId": "fin-ib-sales-trader-kp-023"
    },
    {
      "category": "pitfalls",
      "text": "机构销售能做得比较出色才有转岗机会，转岗的前提是从业期间业绩出众。",
      "kpId": "fin-ib-sales-trader-kp-024"
    },
    {
      "category": "pitfalls",
      "text": "三中一华等头部券商竞争激烈，内部转岗难度很大。",
      "kpId": "fin-ib-sales-trader-kp-025"
    },
    {
      "category": "pitfalls",
      "text": "股销部面临研究所价值弱化、研究同质化的困境，单纯卖研报的商业模式增长受限。",
      "kpId": "fin-ib-sales-trader-kp-026"
    },
    {
      "category": "pitfalls",
      "text": "这是一个资源加服务型岗位，需承受业绩压力，并认清传统商业模式面临的挑战及向综合服务转型的行业趋势。",
      "kpId": "fin-ib-sales-trader-kp-027"
    },
    {
      "category": "pitfalls",
      "text": "行业饱和度和竞争会更激烈，从业者素质持续快速升级，低学历、差背景的机构销售在面对高学历、优秀背景的买方时更难获得信任。",
      "kpId": "fin-ib-sales-trader-kp-028"
    },
    {
      "category": "pitfalls",
      "text": "机构销售不是终点，不可能一辈子做销售，需要提前规划后路，持续积累学识和视野。",
      "kpId": "fin-ib-sales-trader-kp-029"
    }
  ],
