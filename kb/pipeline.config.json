  },
  "scope": {
    "industries": ["金融", "互联网"],
    "directions": {
      "金融": ["银行", "证券/投行", "基金/资管", "保险", "互金/金融科技"],
      "互联网": ["运营", "产品", "风控/反欺诈", "数据分析"]
    }
  },
  "orchestration": {
    "dispatch": "serial",
    "maxRetriesPerStage": 2,
    "maxQaFallbackRounds": 2,
    "failurePolicy": "skip-and-record",
    "pilotPositionCount": 3
  },
  "qaSampleRate": 0.1,
  "clean": {
    "minQuality": 60,
    "minChars": 100
  },
  "positions": []
