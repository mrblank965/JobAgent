{
  "version": "0.1.0",
  "updatedAt": "2026-10-15",
  "goal": "支撑「拆解 JD」功能：判断岗位到底做什么、还原完整工作流程",
  "principle": {
    "primary": "优先采用知识库里的真实岗位内容作为依据",
